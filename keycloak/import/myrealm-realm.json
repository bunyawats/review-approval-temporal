{
  "realm": "myrealm",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      {
        "name": "Operator",
        "description": "Creates and manages their own review requests.",
        "composite": false
      },
      {
        "name": "Manager",
        "description": "Approves or rejects pending review requests.",
        "composite": false
      },
      {
        "name": "TemporalAdmin",
        "description": "May log into the Temporal Web UI. Grants unfiltered visibility into every workflow's payload across all requesters -- assign deliberately, not by default.",
        "composite": false
      }
    ]
  },
  "clients": [
    {
      "clientId": "review-approval",
      "name": "Review Approval API",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-secret-change-me",
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8000/ui/callback",
        "http://bff:8000/ui/callback"
      ],
      "webOrigins": ["http://localhost:8000"],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:8000/ui/login##http://bff:8000/ui/login"
      },
      "authorizationServicesEnabled": true,
      "authorizationSettings": {
        "allowRemoteResourceManagement": true,
        "policyEnforcementMode": "ENFORCING",
        "decisionStrategy": "UNANIMOUS",
        "resources": [
          {
            "name": "Create_Request",
            "displayName": "Create Request",
            "ownerManagedAccess": false
          },
          {
            "name": "Update_Request",
            "displayName": "Update Request",
            "ownerManagedAccess": false
          },
          {
            "name": "Cancel_Request",
            "displayName": "Cancel Request",
            "ownerManagedAccess": false
          },
          {
            "name": "Approve_Request",
            "displayName": "Approve Request",
            "ownerManagedAccess": false
          },
          {
            "name": "Reject_Request",
            "displayName": "Reject Request",
            "ownerManagedAccess": false
          }
        ],
        "policies": [
          {
            "name": "Operator Policy",
            "description": "Requires the Operator realm role.",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\":\"Operator\",\"required\":true}]"
            }
          },
          {
            "name": "Manager Policy",
            "description": "Requires the Manager realm role.",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\":\"Manager\",\"required\":true}]"
            }
          },
          {
            "name": "Create_Request Permission",
            "description": "Operator role may create requests.",
            "type": "resource",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"Create_Request\"]",
              "applyPolicies": "[\"Operator Policy\"]"
            }
          },
          {
            "name": "Update_Request Permission",
            "description": "Operator role may update requests.",
            "type": "resource",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"Update_Request\"]",
              "applyPolicies": "[\"Operator Policy\"]"
            }
          },
          {
            "name": "Cancel_Request Permission",
            "description": "Operator role may cancel requests.",
            "type": "resource",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"Cancel_Request\"]",
              "applyPolicies": "[\"Operator Policy\"]"
            }
          },
          {
            "name": "Approve_Request Permission",
            "description": "Manager role may approve requests.",
            "type": "resource",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"Approve_Request\"]",
              "applyPolicies": "[\"Manager Policy\"]"
            }
          },
          {
            "name": "Reject_Request Permission",
            "description": "Manager role may reject requests.",
            "type": "resource",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "resources": "[\"Reject_Request\"]",
              "applyPolicies": "[\"Manager Policy\"]"
            }
          }
        ]
      }
    },
    {
      "clientId": "temporal-ui",
      "name": "Temporal Web UI",
      "enabled": true,
      "publicClient": false,
      "secret": "temporal-ui-dev-secret-change-me",
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8233/auth/sso/callback"
      ],
      "webOrigins": ["http://localhost:8233"],
      "authenticationFlowBindingOverrides": {
        "browser": "b10c3f6e-0000-4000-8000-000000000001"
      }
    }
  ],
  "authenticationFlows": [
    {
      "id": "b10c3f6e-0000-4000-8000-000000000001",
      "alias": "temporal-ui-browser",
      "description": "Username/password login for the Temporal Web UI, gated to the TemporalAdmin role. No SSO-cookie reuse from the review-approval client on purpose, so the role check always runs.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 20,
          "autheticatorFlow": true,
          "flowAlias": "temporal-ui-require-admin-role",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "temporal-ui-require-admin-role",
      "description": "Denies login to any user without the TemporalAdmin role.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "authenticatorConfig": "require-temporal-admin-role",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticator": "deny-access-authenticator",
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "require-temporal-admin-role",
      "config": {
        "condUserRole": "TemporalAdmin",
        "negate": "true"
      }
    }
  ],
  "users": [
    {
      "username": "operator1",
      "firstName": "Operator",
      "lastName": "One",
      "email": "operator1@example.com",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [
        {"type": "password", "value": "password", "temporary": false}
      ],
      "realmRoles": ["Operator", "default-roles-myrealm"]
    },
    {
      "username": "operator2",
      "firstName": "Operator",
      "lastName": "Two",
      "email": "operator2@example.com",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [
        {"type": "password", "value": "password", "temporary": false}
      ],
      "realmRoles": ["Operator", "default-roles-myrealm"]
    },
    {
      "username": "manager1",
      "firstName": "Manager",
      "lastName": "One",
      "email": "manager1@example.com",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [
        {"type": "password", "value": "password", "temporary": false}
      ],
      "realmRoles": ["Manager", "default-roles-myrealm"]
    },
    {
      "username": "manager2",
      "firstName": "Manager",
      "lastName": "Two",
      "email": "manager2@example.com",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [
        {"type": "password", "value": "password", "temporary": false}
      ],
      "realmRoles": ["Manager", "default-roles-myrealm"]
    },
    {
      "username": "temporal-admin1",
      "firstName": "Temporal",
      "lastName": "Admin",
      "email": "temporal-admin1@example.com",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [
        {"type": "password", "value": "password", "temporary": false}
      ],
      "realmRoles": ["TemporalAdmin", "default-roles-myrealm"]
    }
  ]
}
