# Copy to .env and fill in, or export these in your shell before running.

DATABASE_URL=postgresql://ai.engineer@localhost:5432/review.approval.temporal.db
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default

# Keycloak realm base URL, e.g. http://localhost:8080/realms/myrealm
KEYCLOAK_ISSUER=http://localhost:8080/realms/myrealm

# Session cookie signing key for the POC /ui/* mock-auth screens.
# Fine to leave unset for local single-process dev (insecure fallback is
# used). Required (as a real random value, shared across pods) in any
# multi-replica/Kubernetes deployment -- see CLAUDE.md's Kubernetes section.
UI_SESSION_SECRET=
